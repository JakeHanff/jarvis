# ─── JARVIS configuration ────────────────────────────────────────────────
# Copy to .env (npm run setup does this) and fill in what you need.
# .env is git-ignored. Never put these values in frontend code.

# ── AI model (chat). Pick ONE option ──

# Option A — FREE: a local model through Ollama (https://ollama.com). See README.
# JARVIS_AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# Option B — paid, smartest: Claude. Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  — higher = more thorough, slower, costlier
ANTHROPIC_EFFORT=medium

# Optional alternative provider (used if JARVIS_AI_PROVIDER=openai, or auto with no Anthropic key)
# JARVIS_AI_PROVIDER=auto
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Access token. REQUIRED before using `npm run dev:lan` or exposing JARVIS beyond this PC.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_ACCESS_TOKEN=

# Storage. Empty = local SQLite file at ./data/jarvis.db
# For cloud sync, use your Supabase Postgres connection string (Session pooler):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
